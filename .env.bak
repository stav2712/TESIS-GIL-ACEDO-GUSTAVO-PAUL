# =========================
# SEGURIDAD / IDENTITY
# =========================
JWT_SECRET=CAMBIA_ESTE_SECRETO_LARGO
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
AUTH_DB_URL=sqlite:///./data/auth.db

# =========================
# BASE CLINICA
# =========================
CLINICAL_DB_URL=postgresql+psycopg2://postgres:dbtavo@localhost:5432/synthea_omop
DB_DIALECT=postgresql

# Solo vistas canónicas de reporting
ALLOWED_TABLES=reporting.vw_alergias,reporting.vw_centros_atencion,reporting.vw_cobertura_pagador,reporting.vw_defunciones,reporting.vw_diagnosticos,reporting.vw_dispositivos,reporting.vw_encuentros,reporting.vw_estudios_imagen,reporting.vw_eventos_clinicos,reporting.vw_inmunizaciones,reporting.vw_mapa_encuentros_native,reporting.vw_medicamentos,reporting.vw_mediciones,reporting.vw_observaciones,reporting.vw_paciente_360,reporting.vw_pacientes,reporting.vw_planes_cuidado,reporting.vw_procedimientos,reporting.vw_profesionales,reporting.vw_reclamos,reporting.vw_reclamos_transacciones,reporting.vw_suministros,reporting.vw_ubicaciones

# =========================
# ORCHESTRATOR / MICROSERVICIOS
# =========================

# Motor NL-to-SQL en Modal.
# Puede ir con /translate porque el código que te pasé lo acepta así.
TRANSLATOR_URL=https://gilgustavo062--qwen-nl2sql-demo-web.modal.run/translate
TRANSLATOR_TIMEOUT_SECONDS=180

# Gestor SQL local.
# Este SÍ debe quedarse con /execute.
QUERY_URL=http://127.0.0.1:8003/execute

# Servicio de terminología local.
# IMPORTANTE: aquí NO pongas /normalize, porque el cliente del orquestador lo agrega.
TERMINOLOGY_URL=http://127.0.0.1:8004

MONGO_URI=mongodb://localhost:27017
MONGO_DB=nl2sql_logs
MONGO_COLLECTION=queries
MONGO_CONVERSATIONS_COLLECTION=conversations

EXPORT_MAX_ROWS=10000
CORS_ORIGINS=http://localhost:5173

# =========================
# PERFIL DE ESQUEMA
# =========================
SCHEMA_PROFILE_PATH=./data/schema/default_reporting_profile.json

# =========================
# TERMINOLOGIA
# =========================
SYNONYMS_CSV=./data/terminology/synonyms.csv
CONCEPTS_CSV=./data/terminology/concepts.csv
VALUES_CSV=./data/terminology/value_map.csv

# =========================
# TRANSLATOR LOCAL / LEGACY
# =========================
# Estas variables quedan por si todavía levantas el translator_service local.
# Con Modal ya no deberían ser usadas por el orquestador.
MODEL_BACKEND=hf_seq2seq

MODEL_PATH=./translator_service/model/mt5_clinical_sql
MODEL_NAME=google/mt5-base

MODEL_DEVICE=auto
MAX_INPUT_TOKENS=2048
MAX_NEW_TOKENS=256
MODEL_NUM_BEAMS=4
MODEL_TEMPERATURE=0.0

DEFAULT_TRANSLATOR_LIMIT=100
USE_RULE_FALLBACK=true
RETURN_PROMPT_PREVIEW=false