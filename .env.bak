DEFAULT_TRANSLATOR_LIMIT=100
USE_RULE_FALLBACK=true
RETURN_PROMPT_PREVIEW=false

# =========================
QUERY_TIMEOUT_SECONDS=300
# =========================

# Límite visual/navegable de resultados en la plataforma.
# Si una consulta devuelve más de 5000 filas, la UI pagina solo hasta 5000
# y muestra un aviso. Exportación NO usa este límite.
QUERY_DISPLAY_MAX_ROWS=5000

# 0 = exportar todo lo que devuelva la consulta.
# Si quieres un límite duro de seguridad para exportaciones, pon por ejemplo 100000.
EXPORT_MAX_ROWS=0

# Tamaño interno de página para exportaciones.
EXPORT_PAGE_SIZE=1000

